{
  "name": "codexbei",
  "version": "0.1.1-alpha.2",
  "private": true,
  "description": "CodexBei 桌面配置助手",
  "author": "BeiAPI",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "dev:react": "vite --config desktop/vite.config.ts",
    "build:react": "npm run build:ui-icons && tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "build": "tauri build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "build:mac:release": "node scripts/build-mac-release.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "test": "npm run test:rust && npm run test:worker",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:worker": "node --test test/worker.test.cjs test/updates.test.cjs",
    "test:ui": "npm run build:react && node --test test/react.e2e.cjs",
    "check": "npm run build:react && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "worker:check": "wrangler types worker/env.d.ts && tsc -p worker/tsconfig.json && node scripts/publish-templates.cjs",
    "build:ui-icons": "node scripts/build-ui-icons.cjs"
  },
  "dependencies": {
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "1.43.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "wrangler": "^4.129.1"
  }
}
