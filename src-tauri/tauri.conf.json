{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBei",
  "version": "0.1.2",
  "identifier": "cn.beiapi.codexbei",
  "build": {
    "beforeDevCommand": "npm run dev:react",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:react",
    "frontendDist": "../dist-react"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexBei",
        "width": 600,
        "height": 520,
        "minWidth": 460,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "CodexBei 桌面配置助手",
    "icon": [
      "../build/icon.icns",
      "../build/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "codexbei"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NzVBMjg2NEJDMkUwQUYKUldTdjRNSkxocUoxdUdSV3c3aWpDL2ZOczJ5d3ZLY2ZvR0dONzlmUXhQeUlqZloycFNtRW9wNFUK",
      "endpoints": [
        "https://codexbei.beiapi.cn/updates/v1/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
